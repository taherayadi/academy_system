# Vite client env vars — local dev only (`npm run dev`).
# Copy to `.env` (gitignored) and fill with your own keys.
# In production these are baked at build time from Cloudflare Pages →
# Settings → Environment variables (Production + Preview).
#
# Where to get keys: https://admin.pubnub.com/ (free account) → your keyset.
VITE_PUBNUB_PUBLISH_KEY=demo
VITE_PUBNUB_SUBSCRIBE_KEY=demo
